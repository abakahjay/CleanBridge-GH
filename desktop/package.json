{
  "name": "cleanbridge-gh-desktop",
  "productName": "CleanBridge GH",
  "version": "1.0.0",
  "description": "CleanBridge GH for Windows - book and track waste pickups across Ghana",
  "author": "Abakah Joshua",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.cleanbridgegh.desktop",
    "productName": "CleanBridge GH",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CleanBridge GH",
      "runAfterFinish": true,
      "artifactName": "CleanBridge-GH-Setup.exe"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  }
}
